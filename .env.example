# Copie para .env.local. Valores abaixo são os padrões do Supabase local (npm run db:start).

# Postgres (usado pelos adaptadores de infra dos módulos, somente no servidor)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase (Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL canônica do app (links de e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Missões: segredo para assinar os QR codes das etapas (HMAC, somente no servidor). Obrigatório, mínimo 32
# caracteres, um por ambiente. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MISSIONS_QR_SECRET=

# Recomendação (opcional): ajusta os pesos do score sem mudar código (JSON parcial; cada peso de 0 a 10).
# Sinais: preference, happeningNow, live, novelty, favorite, proximity. Vazio = padrões de score-weights.ts.
# Ex.: RECOMMENDATION_WEIGHTS={"live":5,"novelty":0}
RECOMMENDATION_WEIGHTS=
# Live (somente no servidor; veja docs/live.md). Com MUX_TOKEN_ID usa o Mux; sem, um provedor simulado.
# Mux: Settings → Access Tokens (permissão Mux Video: Read + Write) e Settings → Webhooks (Signing Secret).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# Simulado (desenvolvimento/E2E, quando MUX_TOKEN_ID está vazio): segredo dos webhooks simulados. Obrigatório nesse
# modo, mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LIVE_FAKE_WEBHOOK_SECRET=

# Mapa (opcional): estilo vetorial de um provedor (MapTiler/Stadia/Protomaps) para produção.
# Vazio = tiles públicos do OpenStreetMap (só para desenvolvimento/POC).
NEXT_PUBLIC_MAP_STYLE_URL=

# Observabilidade (RNF10). Sem DSN, o Sentry fica desligado e só os logs locais funcionam.
LOG_LEVEL=debug
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_ENV=local
# Somente CI/produção, para upload de source maps (nunca commitar o token):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
