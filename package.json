{
  "name": "lalaia",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "vendor:maplibre": "node scripts/copy-maplibre-worker.mjs",
    "predev": "npm run vendor:maplibre",
    "prebuild": "npm run vendor:maplibre",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:int": "vitest run --project int",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run places:seed",
    "db:new": "supabase migration new",
    "db:status": "supabase status",
    "test:e2e": "npm run build && playwright test",
    "role": "node --env-file-if-exists=.env.local scripts/role.mjs",
    "load:live": "node --env-file-if-exists=.env.local scripts/load/live-audience.mjs",
    "places:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local src/modules/places/features/import-osm/import-osm.cli.ts",
    "places:import": "tsx --conditions=react-server --env-file-if-exists=.env.local src/modules/places/features/import-osm/import-osm.cli.ts --live",
    "perf": "lhci autorun --config=./lighthouserc.cjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.7",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "eslint-plugin-boundaries": "^7.2.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "browserslist": [
    "defaults",
    "not dead",
    "iOS >= 15",
    "Safari >= 15"
  ],
  "engines": {
    "node": ">=22"
  }
}
